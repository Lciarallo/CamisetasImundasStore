# Configuração do app web do Firebase.
# Pegue os valores em: Console do Firebase > Configurações do projeto > Seus apps
# Estas chaves são públicas por natureza — vão no bundle e ficam visíveis no
# navegador. O que protege os dados são as regras de segurança e as Cloud
# Functions, não o sigilo da apiKey.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Deixe "true" no .env.local para desenvolver contra os emuladores.
VITE_USE_EMULATORS=false

# --------------------------------------------------------------------------
# Banco Inter — NÃO vai aqui.
#
# As credenciais do PIX ficam no Secret Manager, nunca em arquivo .env nem no
# bundle: INTER_CLIENT_ID, INTER_CLIENT_SECRET, INTER_CERTIFICATE,
# INTER_PRIVATE_KEY e INTER_PIX_KEY. Veja "Pagamento" no README.
#
# Para rodar contra o sandbox do Inter, defina INTER_USE_SANDBOX=true no
# ambiente das functions (não aqui).
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# Recebimento PIX direto — também NÃO vai aqui.
#
# Para quem não tem API de cobrança (MEI, por exemplo), a loja monta um BR Code
# estático na própria chave, sem tarifa. Defina as três no ambiente das
# functions, nunca no bundle:
#
#   PIX_DIRECT_KEY, PIX_DIRECT_MERCHANT_NAME, PIX_DIRECT_MERCHANT_CITY
#
# As três são exigidas juntas: faltando uma, produção recusa criar o pedido em
# vez de emitir um QR Code que ninguém honra. O Inter, se configurado, tem
# precedência. Veja "Recebimento direto" no README.
# --------------------------------------------------------------------------
