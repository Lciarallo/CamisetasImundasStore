# Configuração do app web do Firebase.
# Pegue os valores em: Console do Firebase > Configurações do projeto > Seus apps
# Estas chaves são públicas por natureza — vão no bundle e ficam visíveis no
# navegador. O que protege os dados são as regras de segurança e as Cloud
# Functions, não o sigilo da apiKey.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Deixe "true" no .env.local para desenvolver contra os emuladores.
VITE_USE_EMULATORS=false

# --------------------------------------------------------------------------
# InfinitePay (PIX 0% para MEI e PJ) — NÃO vai no bundle cliente.
#
# O handle/tag da InfinitePay fica no Secret Manager ou ambiente seguro das Cloud Functions:
#
#   firebase functions:secrets:set INFINITEPAY_HANDLE
#
# Opcionalmente, configure no ambiente das Cloud Functions:
#   INFINITEPAY_PUBLIC_BASE_URL=https://sua-loja.web.app
#   INFINITEPAY_WEBHOOK_URL=https://southamerica-east1-SEU-PROJETO.cloudfunctions.net/paymentWebhook
# --------------------------------------------------------------------------
